{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pipeliner/hypothesisctl/blob/main/schema/hypothesis-v1.schema.json",
  "title": "hypothesisctl record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis", "gates", "policies"],
  "properties": {
    "schema_version": {"const": "1"},
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "statement": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "status", "rationale", "evidence", "coverage"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked", "unknown"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "sha256"],
              "properties": {
                "ref": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["population", "observed", "unscanned", "collection_failures"],
            "properties": {
              "population": {"type": "string", "minLength": 1},
              "observed": {"type": "integer", "minimum": 0},
              "unscanned": {"type": "array", "items": {"type": "string"}},
              "collection_failures": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requires"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "requires": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
          }
        }
      }
    }
  }
}
